# PORT: Porta onde o servidor de desenvolvimento do Vite escuta localmente (padrão: 3000).
PORT=3000

# DISABLE_HMR: Define como "true" apenas em ambientes de pré-visualização onde HMR via WebSocket é desativado.
DISABLE_HMR=false

# GIT_COMMIT / RENDER_GIT_COMMIT / VITE_APP_COMMIT (Opcional):
# Hash ou identificador do commit injetado durante o build (quando ausente e sem diretório .git, utiliza "local-build").
GIT_COMMIT=
RENDER_GIT_COMMIT=
VITE_APP_COMMIT=
