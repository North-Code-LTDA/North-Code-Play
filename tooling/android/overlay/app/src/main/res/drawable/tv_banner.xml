<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fundo escuro oficial do North Code Play (proporção 320x180dp do Android TV Leanback) -->
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="320dp"
                android:height="180dp" />
            <solid android:color="#000000" />
        </shape>
    </item>
    <!-- Borda sutil para destacar o cartão na tela inicial do Android TV -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#27272A" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <!-- Logomarca centralizada com margem segura para o banner 16:9 -->
    <item
        android:width="128dp"
        android:height="128dp"
        android:gravity="center"
        android:drawable="@mipmap/ic_launcher_foreground" />
</layer-list>
